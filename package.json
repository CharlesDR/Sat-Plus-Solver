{
  "name": "sat-plus-solver",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tooling/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @sps/web build",
    "dev": "pnpm --filter @sps/web dev",
    "build:data": "tsx tooling/build-data.ts",
    "solve": "tsx tooling/solve.ts",
    "e2e": "pnpm --filter @sps/web e2e",
    "world": "tsx tooling/world.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sps/data": "workspace:*",
    "@sps/solver": "workspace:*",
    "@sps/world": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
